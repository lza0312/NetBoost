<Window x:Class="NetBoost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetBoost · 网络加速" Height="880" Width="1320"
        MinHeight="720" MinWidth="1140"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E14" Foreground="#E8ECF5"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <SolidColorBrush x:Key="CardBackground" Color="#141926" />
        <SolidColorBrush x:Key="CardBorder" Color="#1E2536" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E8ECF5" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9AA3B5" />
        <SolidColorBrush x:Key="TextDim" Color="#767F91" />
        <SolidColorBrush x:Key="CellText" Color="#D6DBE6" />
        <SolidColorBrush x:Key="AccentColor" Color="#3B7BFF" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8ECF5" />
            <Setter Property="Background" Value="#1B2233" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26314A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E3A57" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7FA6FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="19,9" />
        </Style>

        <Style x:Key="FlatProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Background" Value="#1B2233" />
            <Setter Property="Foreground" Value="{StaticResource AccentColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 页签：选中态用亮底，文字统一高对比度，避免系统默认的深色字 -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9AA3B5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="16,7" Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B2233" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#151B28" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,10" Background="Transparent" />
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#141926" />
            <Setter Property="Foreground" Value="#9AA3B5" />
            <Setter Property="BorderBrush" Value="#1E2536" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource CellText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#111622" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#1A2130" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource CellText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#22314F" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource CellText}" />
        </Style>

        <Style x:Key="GridCellMuted" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

        <Style x:Key="GridCellStrong" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0F1421" />
            <Setter Property="Foreground" Value="#E8ECF5" />
            <Setter Property="CaretBrush" Value="#E8ECF5" />
            <Setter Property="BorderBrush" Value="#232B3D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1B2233" />
            <Setter Property="Foreground" Value="#E8ECF5" />
            <Setter Property="BorderBrush" Value="#232B3D" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource CardBackground}"
                                                BorderBrush="#232B3D" BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="22" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0"
                                                      Stroke="#9AA3B5" StrokeThickness="1.2"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#141926" BorderBrush="#232B3D" BorderThickness="1"
                                        CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E8ECF5" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22314F" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3A5C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" VerticalAlignment="Center">
                                <Border x:Name="Box" Background="#0F1421" BorderBrush="#2A3347"
                                        BorderThickness="1" CornerRadius="3" />
                                <Path x:Name="CheckMark" Data="M2,7 L5.5,10.5 L12,3.5"
                                      Stroke="#4ADE80" StrokeThickness="1.6" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#3B7BFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="NetBoost" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="多源测速 · 证书校验 · hosts 优化 · DNS 对比"
                           Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,5,0,0" />
            </StackPanel>

            <Border Grid.Column="1" Background="#1B2233" CornerRadius="5" Padding="9,4"
                    VerticalAlignment="Center">
                <TextBlock x:Name="AdminBadge" Text="权限检测中" FontSize="10"
                           Foreground="{StaticResource TextSecondary}" />
            </Border>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="1" SelectionChanged="MainTabs_SelectionChanged">

            <!-- ============ hosts 优化 ============ -->
            <TabItem Header="hosts 优化">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="HostsPathText" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDim}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnOptimize" Style="{StaticResource PrimaryButton}"
                                    Content="一键检测并优化" Click="BtnOptimize_Click" />
                            <Button x:Name="BtnDetect" Style="{StaticResource BaseButton}" Content="仅检测"
                                    Margin="10,0,0,0" Click="BtnDetect_Click" />
                            <Button x:Name="BtnApply" Style="{StaticResource BaseButton}" Content="应用结果"
                                    Margin="10,0,0,0" Click="BtnApply_Click" IsEnabled="False" />
                            <Button x:Name="BtnRestore" Style="{StaticResource BaseButton}" Content="还原 hosts"
                                    Margin="10,0,0,0" Click="BtnRestore_Click" />
                            <Button x:Name="BtnOpenHosts" Style="{StaticResource BaseButton}" Content="查看 hosts"
                                    Margin="10,0,0,0" Click="BtnOpenHosts_Click" />
                            <Button x:Name="BtnForceRefresh" Style="{StaticResource BaseButton}" Content="强制刷新"
                                    Margin="10,0,0,0" Click="BtnForceRefresh_Click"
                                    ToolTip="忽略 5 分钟结果缓存，重新解析并测速（不写入 hosts）" />
                        </StackPanel>

                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IpTableText" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDim}" FontSize="10.5"
                                       TextTrimming="CharacterEllipsis" />
                            <Button x:Name="BtnRefreshIps" Grid.Column="1" Style="{StaticResource BaseButton}"
                                    Content="刷新兜底 IP 表" Padding="10,4" FontSize="11" Margin="10,0,0,0"
                                    Click="BtnRefreshIps_Click"
                                    ToolTip="尝试从公开 hosts 源拉取最新 GitHub IP；失败时继续使用当前表" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="284" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 优化目标 -->
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="优化目标" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="勾选需要加速的服务" Foreground="{StaticResource TextSecondary}"
                                               FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ListBox x:Name="ServiceList" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextPrimary}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,0,6" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1A2030" CornerRadius="8" Padding="10,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  VerticalAlignment="Center" Margin="0,0,10,0" />

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#F2F5FC" />
                                                            <TextBlock Text="{Binding Description}" FontSize="10.5"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <Border Grid.Column="2" CornerRadius="9" Padding="8,2"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding Accent}">
                                                            <TextBlock Text="{Binding DomainCount}" FontSize="10"
                                                                       Foreground="#0B0E14" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- 统计 + 结果 -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,0,14">
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14,11">
                                    <StackPanel>
                                        <TextBlock Text="检测域名" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                        <TextBlock x:Name="StatDomains" Text="—" FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14,11">
                                    <StackPanel>
                                        <TextBlock Text="可优化条目" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                        <TextBlock x:Name="StatOptimized" Text="—" FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14,11">
                                    <StackPanel>
                                        <TextBlock Text="平均延迟（前后）" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                        <TextBlock x:Name="StatLatency" Text="—" FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="14,11">
                                    <StackPanel>
                                        <TextBlock Text="平均首字节（含建连，前后）" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                        <TextBlock x:Name="StatTtfb" Text="—" FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="1" Style="{StaticResource Card}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="检测结果" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock x:Name="SummaryText" Grid.Column="1"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <DataGrid x:Name="ResultsGrid">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="启用" Width="52">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                                                                  IsEnabled="{Binding Applicable}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="服务" Binding="{Binding Service}" Width="104"
                                                                ElementStyle="{StaticResource GridCellText}" />
                                            <DataGridTextColumn Header="域名" Binding="{Binding Host}" Width="*"
                                                                MinWidth="150"
                                                                ElementStyle="{StaticResource GridCellText}" />
                                            <DataGridTextColumn Header="当前 IP" Binding="{Binding OldIpText}" Width="116"
                                                                ElementStyle="{StaticResource GridCellMuted}" />
                                            <DataGridTextColumn Header="当前延迟" Binding="{Binding OldLatencyText}" Width="82"
                                                                ElementStyle="{StaticResource GridCellMuted}" />
                                            <DataGridTextColumn Header="优化 IP" Binding="{Binding NewIpText}" Width="116"
                                                                ElementStyle="{StaticResource GridCellText}" />
                                            <DataGridTextColumn Header="优化延迟" Binding="{Binding NewLatencyText}" Width="82"
                                                                ElementStyle="{StaticResource GridCellStrong}" />
                                            <DataGridTemplateColumn Header="提升" Width="76">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ImprovementText}" VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right" Margin="0,0,4,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#9AA3B5" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Improved}" Value="True">
                                                                            <Setter Property="Foreground" Value="#4ADE80" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="备注" Width="190">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Note}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,0,4,0"
                                                                   ToolTip="{Binding Note}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#9AA3B5" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UsedFallback}" Value="True">
                                                                            <Setter Property="Foreground" Value="#F5C451" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============ DNS 优化 ============ -->
            <TabItem Header="DNS 优化">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnTestDns" Style="{StaticResource PrimaryButton}"
                                    Content="测试全部 DNS" Click="BtnTestDns_Click" />
                            <Button x:Name="BtnApplyDns" Style="{StaticResource BaseButton}"
                                    Content="设为优先 DNS" Margin="10,0,0,0" IsEnabled="False"
                                    Click="BtnApplyDns_Click" />
                            <Button x:Name="BtnRestoreDns" Style="{StaticResource BaseButton}"
                                    Content="还原 DNS" Margin="10,0,0,0" Click="BtnRestoreDns_Click" />
                            <TextBlock Text="网卡" Foreground="{StaticResource TextSecondary}" FontSize="11"
                                       VerticalAlignment="Center" Margin="16,0,6,0" />
                            <ComboBox x:Name="CmbAdapter" Width="220" VerticalAlignment="Center"
                                      SelectionChanged="CmbAdapter_SelectionChanged" />
                        </StackPanel>

                        <TextBlock x:Name="DnsProbeHint" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0"
                                   HorizontalAlignment="Left"
                                   Foreground="{StaticResource TextDim}" FontSize="11" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 当前生效的主/备 -->
                            <Grid Grid.Row="0" Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="当前生效" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="CurrentDnsText" FontSize="12"
                                               Foreground="{StaticResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CurrentDns6Text" FontSize="10.5"
                                               Foreground="{StaticResource TextDim}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="CurrentDnsMatchText" Grid.Column="2" Margin="14,0,0,0"
                                           FontSize="11" Foreground="{StaticResource TextDim}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="#1E2536"
                                    Margin="0,11,0,11" />

                            <!-- 常用组合：点一下同时设置主 + 备 -->
                            <TextBlock Grid.Row="2" Text="常用组合" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Top" Margin="0,3,0,0" />

                            <ItemsControl x:Name="PresetList" Grid.Row="2" Grid.Column="1" Margin="14,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="PresetApply_Click" Cursor="Hand"
                                                Margin="0,0,8,8" ToolTip="第一次点击进入确认，再点一次才写入">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="#1A2030" CornerRadius="8"
                                                            Padding="11,7" BorderThickness="1"
                                                            BorderBrush="#232B3D">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#22304C" />
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#33405C" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#2A3A5C" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#7FA6FF" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#16233A" />
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3B7BFF" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Pending}" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#2A2417" />
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#F5C451" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="#F2F5FC" />
                                                <TextBlock Text="{Binding PairText}" FontSize="10.5"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding MeasuredText}" FontSize="10"
                                                           Foreground="#4ADE80" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MeasuredText}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="当前生效" FontSize="10" Foreground="#4ADE80"
                                                           Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="再点一次确认" FontSize="10" Foreground="#F5C451"
                                                           Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Pending}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 手动输入主/备 -->
                            <TextBlock Grid.Row="3" Text="手动设置" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"
                                        Margin="14,0,0,0">
                                <TextBlock Text="主" Foreground="{StaticResource TextSecondary}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="TxtPrimaryDns" Style="{StaticResource DarkTextBox}"
                                         Width="150" />
                                <TextBlock Text="备" Foreground="{StaticResource TextSecondary}" FontSize="11"
                                           VerticalAlignment="Center" Margin="12,0,6,0" />
                                <TextBox x:Name="TxtSecondaryDns" Style="{StaticResource DarkTextBox}"
                                         Width="150" />
                                <Button x:Name="BtnApplyManualDns" Style="{StaticResource BaseButton}"
                                        Content="应用" Padding="16,7" Margin="12,0,0,0"
                                        Click="BtnApplyManualDns_Click" />
                                <Button x:Name="BtnFillCurrentDns" Style="{StaticResource BaseButton}"
                                        Content="填入当前" Padding="12,7" Margin="8,0,0,0"
                                        Click="BtnFillCurrentDns_Click" />
                                <TextBlock Text="备选留空则只设主 DNS"
                                           Foreground="{StaticResource TextDim}" FontSize="10.5"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>

                            <!-- 可选：一并处理 IPv6 DNS -->
                            <TextBlock Grid.Row="4" Text="IPv6 DNS" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,10,0,0" />

                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"
                                        Margin="14,10,0,0">
                                <CheckBox x:Name="ChkIpv6" Content="同时处理 IPv6 DNS"
                                          Checked="ChkIpv6_Checked" Unchecked="ChkIpv6_Checked" />
                                <TextBlock Text="主" Foreground="{StaticResource TextSecondary}" FontSize="11"
                                           VerticalAlignment="Center" Margin="14,0,6,0" />
                                <TextBox x:Name="TxtIpv6Primary" Style="{StaticResource DarkTextBox}"
                                         Width="170" IsEnabled="False" />
                                <TextBlock Text="备" Foreground="{StaticResource TextSecondary}" FontSize="11"
                                           VerticalAlignment="Center" Margin="12,0,6,0" />
                                <TextBox x:Name="TxtIpv6Secondary" Style="{StaticResource DarkTextBox}"
                                         Width="170" IsEnabled="False" />
                                <TextBlock Text="填地址=设置，留空=清空为自动获取"
                                           Foreground="{StaticResource TextDim}" FontSize="10.5"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DNS 延迟对比" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="DnsSummaryText"
                                               Foreground="{StaticResource TextSecondary}" FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="BtnExportDns" Style="{StaticResource BaseButton}"
                                            Content="导出 CSV" Padding="11,5" FontSize="11"
                                            Margin="12,0,0,0" Click="BtnExportDns_Click" />
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="DnsGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DNS 服务" Binding="{Binding Name}" Width="150"
                                                        ElementStyle="{StaticResource GridCellStrong}" />
                                    <DataGridTextColumn Header="主 DNS" Binding="{Binding Primary}" Width="122"
                                                        ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTextColumn Header="备选 DNS" Binding="{Binding SecondaryText}" Width="122"
                                                        ElementStyle="{StaticResource GridCellMuted}" />
                                    <DataGridTextColumn Header="延迟" Binding="{Binding LatencyText}" Width="88"
                                                        SortMemberPath="LatencyMs"
                                                        ElementStyle="{StaticResource GridCellStrong}" />
                                    <DataGridTextColumn Header="备选延迟" Binding="{Binding SecondaryLatencyText}" Width="88"
                                                        SortMemberPath="SecondaryLatencyMs"
                                                        ElementStyle="{StaticResource GridCellMuted}" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="112"
                                                        ElementStyle="{StaticResource GridCellMuted}" />
                                    <DataGridTextColumn Header="解析结果" Binding="{Binding AnswerTextOrDash}" Width="118"
                                                        ElementStyle="{StaticResource GridCellMuted}" />
                                    <DataGridTemplateColumn Header="操作" Width="72">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="应用" Style="{StaticResource BaseButton}"
                                                        Padding="10,3" FontSize="11"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Click="DnsRowApply_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="说明" Binding="{Binding NoteText}" Width="*"
                                                        MinWidth="140"
                                                        ElementStyle="{StaticResource GridCellMuted}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 底部状态 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressBar x:Name="Progress" Grid.Row="0" Grid.ColumnSpan="2"
                         Style="{StaticResource FlatProgress}" Minimum="0" Maximum="100" Value="0" />

            <TextBlock x:Name="StatusText" Grid.Row="1" Text="准备就绪"
                       Foreground="{StaticResource TextSecondary}" FontSize="11"
                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TimingText" Grid.Row="1" Grid.Column="1"
                       Foreground="{StaticResource TextDim}" FontSize="11" Margin="12,8,0,0" />
        </Grid>
    </Grid>
</Window>
